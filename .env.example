# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: Dashboard -> Connect), e.g.
#   postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
# Leave empty to use a local SQLite file.
DATABASE_URL=

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public address of the app (https in production - needed for secure cookies and push)
APP_URL=http://localhost:8000

# Web Push keys - generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email for "Forgot password?" links. With Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
# Leave SMTP_HOST empty in local development: reset links are printed in the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=you@gmail.com

# Secret for the reminder URL that UptimeRobot calls every 5 minutes:
#   https://YOUR-APP.onrender.com/api/tasks/send-notifications?key=CRON_SECRET
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
CRON_SECRET=

# Comma-separated emails that can see the /admin statistics page
ADMIN_EMAILS=you@example.com
